# ==============================================================================
# Student Wellness & Burnout Detection System - Backend Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env to Git — it is gitignored by default.

# Application Environment ('development' or 'production')
NODE_ENV=production

# Server Port
PORT=5000

# Client Application URL for CORS (comma-separated if multiple domains)
# e.g., https://student-wellness.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================================================================
# Email — Brevo SMTP (Primary — works on Render Free via port 2525)
# ==============================================================================
#
# Setup steps:
#   1. Sign up free at https://brevo.com (any email, no custom domain required)
#   2. Verify your sender address: Dashboard → Senders & IP → Senders → Add a Sender
#      Enter your email address → click the verification link sent to your inbox.
#      You can use a Gmail address as the sender — no DNS records required.
#   3. Get SMTP credentials: Dashboard → SMTP & API → SMTP → Generate SMTP key
#      EMAIL_USER = your Brevo login email
#      EMAIL_PASS = the generated SMTP key (long string starting with "xsmtpsib-")
#
# Port notes:
#   Render Free explicitly blocks ports 25, 465, and 587.
#   Port 2525 is NOT in the blocked list and is confirmed working with Brevo.
#   Use EMAIL_PORT=2525 on Render. Use 587 for local dev if 2525 is unavailable locally.
#
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your-brevo-login@example.com
EMAIL_PASS=your-brevo-smtp-key-here
EMAIL_FROM=Student Wellness System <your-verified-sender@example.com>

# ==============================================================================
# JWT Authentication Secret
# ==============================================================================
# Generate a strong 256-bit secret via: openssl rand -base64 32
JWT_SECRET=your-secure-random-256-bit-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================================================
# Python ML Worker Configuration (Optional)
# ==============================================================================
# Leave blank to auto-detect system python / python3 or virtualenv
# PYTHON_PATH=/usr/bin/python3
