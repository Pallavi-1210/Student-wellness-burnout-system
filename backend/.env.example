# ==============================================================================
# Student Wellness & Burnout Detection System - Backend Environment Configuration
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=production

# Server Port
PORT=5000

# Client Application URL for CORS (comma-separated if multiple domains)
# e.g., https://student-wellness.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================================================================
# Email Configuration
# ==============================================================================
#
# PRIMARY (Required on Render and all cloud hosts):
#   Resend HTTPS API — sends email over HTTPS (port 443).
#   Render Free tier BLOCKS outbound SMTP (ports 465/587), causing ETIMEDOUT.
#   Resend bypasses this entirely by using the standard HTTPS port.
#
#   Setup steps:
#     1. Sign up free at https://resend.com
#     2. Go to API Keys → Add API Key → copy the key (starts with "re_")
#     3. Add RESEND_API_KEY to your Render environment variables
#
#   Free plan limitation: Without a verified domain, emails can only be
#   delivered to YOUR OWN Resend account email address (using onboarding@resend.dev).
#   To send to all students, verify a custom domain at https://resend.com/domains.
#
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address (optional — set after verifying a domain in Resend):
# Without a verified domain, leave blank to auto-use "onboarding@resend.dev"
# EMAIL_FROM=Student Wellness System <noreply@yourdomain.com>

# ==============================================================================
# Legacy SMTP Fallback (Local Development Only — DO NOT use on Render)
# ==============================================================================
# Outbound SMTP is blocked on Render Free tier (ETIMEDOUT on port 465/587).
# These variables are only used when RESEND_API_KEY is NOT set.
# Uncomment for local offline development only.
#
# Option 1: Gmail App Password
#   Generate at: https://myaccount.google.com/apppasswords
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password

# Option 2: Custom SMTP Server
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_SECURE=false

# ==============================================================================
# JWT Authentication Secret
# ==============================================================================
# Generate a strong 256-bit secret via: openssl rand -base64 32
JWT_SECRET=your-secure-random-256-bit-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================================================
# Python ML Worker Configuration (Optional)
# ==============================================================================
# Leave blank to auto-detect system python / python3 or virtualenv
# PYTHON_PATH=/usr/bin/python3
